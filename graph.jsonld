      ],
      "status": "open",
      "limitations": "No node run or complete finalization/admission audit. This question is not a claim that no hosting mechanism exists elsewhere."
    },
    {
      "@id": "urn:dregg:assortia:I-MIXED-PROGRAMMING",
      "@type": "Intent",
      "label": "A mixed offering with kernel and shell programmability",
      "description": "Ember explicitly permits a mix of first-application activities, provided the environment is programmable at the DREGG kernel level / integrated with a programmable shell at some level. Selecting one application genre is not a prerequisite; language, surface and exact integration remain open.",
      "sources": [
        "urn:dregg:assortia:S-CONVERSATION"
      ]
    },
    {
      "@id": "urn:dregg:assortia:I-CORE-SPRINT",
      "@type": "Intent",
      "label": "Close the necessary gaps throughout the core and consuming stack",
      "description": "Ember calls for a long comprehensive sprint, implementing as far up and down the stack as needed instead of accepting limitations and working around them. The expectation that roughly 20–60% may be core work is planning context, not a measured estimate or ceiling. Use a wide coordinated swarm.",
      "sources": [
        "urn:dregg:assortia:S-CONVERSATION"
      ]
    },
    {
      "@id": "urn:dregg:assortia:I-AUTONOMOUS-NIGHT",
      "@type": "Intent",
      "label": "Autonomous work with three-machine build capacity and owner contact",
      "description": "Ember deputizes autonomous work and makes the laptop, persvati and hbox available for the night; hbox bulk work uses /tank. Existing lease/build discipline applies. Owner-only Telegram contact is explicitly authorized through the identified /chreatures bot; credentials and chat identifiers are not part of this graph.",
      "sources": [
        "urn:dregg:assortia:S-CONVERSATION"
      ]
    },
    {
      "@id": "urn:dregg:assortia:I-REGULAR-CHECKPOINTS",
