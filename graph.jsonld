    {
      "@id": "urn:dregg:assortia:I-NEXUS",
      "@type": "Intent",
      "label": "An extensible DREGG-native programmable nexus",
      "description": "Ember has not selected a first workroom/game/computation activity. The desired offering is a programmable nexus that grows to encompass the suite, explicitly including Clutch in the planning.",
      "subject": "urn:dregg:assortia:E-WORLD",
      "sources": [
        "urn:dregg:assortia:S-CONVERSATION"
      ]
    },
    {
      "@id": "urn:dregg:assortia:I-SELFHOST",
      "@type": "Intent",
      "label": "Participants can run their own DREGG nodes and host cells",
      "description": "Participant-operated nodes and cell hosting are part of the intended world; the exact transport, authority and hosting contract remain design work.",
      "subject": "urn:dregg:assortia:E-WORLD",
      "sources": [
        "urn:dregg:assortia:S-CONVERSATION"
      ]
    },
    {
      "@id": "urn:dregg:assortia:I-SOLANA",
      "@type": "Intent",
      "label": "Meaningful on-chain Solana participation and token utility",
      "description": "Ember ideally wants the first offering to include some on-chain Solana function with real token utility. The economic operation, asset/cluster and release scope remain unselected.",
      "subject": "urn:dregg:assortia:E-SOLANA",
      "sources": [
        "urn:dregg:assortia:S-CONVERSATION"
      ]
    },
    {
      "@id": "urn:dregg:assortia:C-NEXUS-INTERFACE",
      "@type": "Claim",
      "label": "First-order Hyperdocument interface negotiation already has a semantic carrier",
      "description": "QuerySuccess and ActionSuccess retain exact request-indexed authorization, capability scope and pre-root. Action negotiation retains a declaration; constructing an accepted effect remains a later obligation.",
      "subject": "urn:dregg:assortia:E-WORLD",
      "sources": [
        "urn:dregg:assortia:S-NEXUS-INTERFACE"
      ],
      "evidenceKind": "source-inspection",
      "scope": "Selected minidregg Theory interface definitions",
      "limitations": "No Lean replay, deployed network API, durable handler or nexus consumer was established by this read.",
      "status": "observed-in-source"
    },
    {
      "@id": "urn:dregg:assortia:C-SOLANA-HOLDING",
      "@type": "Claim",
      "label": "The configured holder path is Token-2022 mainnet admission through beta RPC evidence",
      "description": "GateConfig pins the public DREGG mint, mainnet cluster and Token-2022 program. The HTTP path validates an RPC snapshot and calls admit_beta to issue a capability.",
      "subject": "urn:dregg:assortia:E-SOLANA",
      "sources": [
        "urn:dregg:assortia:S-POA-HOLDING-POLICY",
        "urn:dregg:assortia:S-POA-HOLDING-ADMIT"
      ],
      "evidenceKind": "source-inspection",
      "scope": "PoA source configuration and selected HTTP admission path",
      "limitations": "No current chain query or issued capability was observed. Admission is not token locking, transfer, provider registration or verified job execution.",
      "status": "observed-in-source"
    },
    {
      "@id": "urn:dregg:assortia:C-SOLANA-LOCK-TOKEN",
      "@type": "Claim",
      "label": "Existing lock processor is incompatible with the holder policy token-program choice",
      "description": "The holder policy pins Token-2022 while solana-lock initialization, lock and escrow paths explicitly require legacy spl_token::id() and construct legacy-token instructions. This path requires compatibility work before reusing it for the configured asset.",
      "subject": "urn:dregg:assortia:E-SOLANA",
      "sources": [
        "urn:dregg:assortia:S-POA-HOLDING-POLICY",
        "urn:dregg:assortia:S-SOLANA-LOCK-TOKEN"
      ],
      "evidenceKind": "source-inspection",
      "scope": "Inspected policy and solana-lock processor bytes",
      "limitations": "No deployment/current mint inspection or custody audit. Token-2022 support alone would not establish provider binding, release rules or bond safety.",
      "status": "observed-in-source"
    },
    {
      "@id": "urn:dregg:assortia:C-CLUTCH-ASSET",
      "@type": "Claim",
      "label": "Clutch has explicit Realm collateral and funding bindings",
      "description": "RealmV1 binds a token program, collateral mint, adapter release and issuer-authority policies. RealmCollateralBindingV1 adds a named refund beneficiary. These are concrete attachment points for a selected asset; the bounded inspection established no real DREGG deployment.",
      "subject": "urn:dregg:assortia:E-CLUTCH",
      "sources": [
        "urn:dregg:assortia:S-CLUTCH-REALM",
        "urn:dregg:assortia:S-CLUTCH-FUNDING",
        "urn:dregg:assortia:S-CLUTCH-REVIEW"
      ],
      "evidenceKind": "source-inspection",
      "scope": "Active dclutch source at recorded file bytes; token-role absence limited to inspected paths",
      "limitations": "A configured Realm is not a nexus resource adapter, provider stake contract or live token-utility claim.",
      "status": "observed-in-source"
    },
    {
      "@id": "urn:dregg:assortia:C-CLUTCH-DIRECT",
      "@type": "Claim",
      "label": "Clutch Direct has a browser/SDK/Solana consuming path to evaluate",
      "description": "The inspected flow reads finalized market and selected route records, prepares wallet-bound participation and replay nonces, and reaches Trading Hot admission with a Direct crosscheck before prepared commit.",
      "subject": "urn:dregg:assortia:E-CLUTCH",
      "sources": [
        "urn:dregg:assortia:S-CLUTCH-DIRECT-SDK",
        "urn:dregg:assortia:S-CLUTCH-DIRECT-FLOW",
        "urn:dregg:assortia:S-CLUTCH-HOT-ENTRY",
        "urn:dregg:assortia:S-CLUTCH-HOT-COMMIT"
      ],
      "evidenceKind": "source-inspection",
      "scope": "Selected Direct path in the active dclutch working tree; source records distinguish any HEAD differences",
      "limitations": "No build or execution was performed. Does not establish every Direct action, current cohort deployment, DREGG-cell integration or the external Hermes agent.",
      "status": "observed-in-source"
    },
    {
      "@id": "urn:dregg:assortia:C-CLUTCH-EVIDENCE",
      "@type": "Claim",
      "label": "September 9 handoff distinguishes old devnet cohort and partial local runtime evidence",
      "description": "The handoff records cohort 17 as the previous public devnet deployment, no fresh current-source all-program cohort, and local Direct fills limited to founder-as-seller. It records remaining runtime checks for the reciprocal seller repair.",
      "subject": "urn:dregg:assortia:E-CLUTCH",
      "sources": [
        "urn:dregg:assortia:S-CLUTCH-HANDOFF"
      ],
      "evidenceKind": "dated-handoff-report",
      "scope": "Dated September 9 handoff, read September 17",
      "limitations": "No current live probe or build result. Later working-tree changes cannot borrow the recorded deployment evidence.",
      "status": "recorded-not-replayed"
    },
    {
      "@id": "urn:dregg:assortia:W-SOLANA-UTILITY",
      "@type": "WorkItem",
      "label": "Choose and close one economic operation consumed by a nexus resource",
      "description": "Compare provider bonds, resource payments and Clutch claim/settlement operations. Holder admission is useful existing material but does not alone perform an on-chain mutation. Specify the real asset/cluster and the DREGG receiver of the external result.",
      "status": "candidate-design",
      "motivatedBy": [
        "urn:dregg:assortia:I-SOLANA",
        "urn:dregg:assortia:I-PROVIDERS",
        "urn:dregg:assortia:I-NEXUS"
      ],
      "related": [
