    {
      "@id": "urn:dregg:assortia:C-BREAD-TOOL-INTENT-0919",
      "@type": "Claim",
      "label": "Tool intent events do not bind exact payloads or execution outcomes",
      "description": "Hermes event projection uses FNV-1a over strings; file writes include path digest/prefix and content length, not content bytes. A committed event does not establish physical execution or the intended exact request binding.",
