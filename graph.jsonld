        "urn:dregg:assortia:S-CONSUMERS-REVIEW"
      ],
      "evidenceKind": "source-and-worktree-inspection",
      "scope": "Uncommitted Projection V2 experiment",
      "limitations": "Not a landed dependency or semantic consumer cutover; V2 versus richer/narrower alternatives remains an explicit receiver choice.",
      "status": "uncommitted-data-crossing"
    },
