    {
      "@id": "urn:dregg:assortia:C-CELL-PROGRAM-DATA",
      "@type": "Claim",
      "label": "Serializable cell rules exist; native/proof installation needs coordinated implementation",
      "description": "Breadstuffs Predicate/Cases are authored transition-rule data consumed by the ordinary executor. SetProgram has an ordinary installation arm, but is absent from native producer mappability and classified as an UnprojectedMover consumed by sovereign proof refusal. Full selected install/invoke/finalize/recover closure is implementation work.",
      "subject": "urn:dregg:assortia:R-breadstuffs",
      "sources": [
        "urn:dregg:assortia:S-CELL-PROGRAM-DATA",
        "urn:dregg:assortia:S-PROGRAM-INSTALL",
