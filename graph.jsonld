    {
      "@id": "urn:dregg:assortia:I-CORE-REORIENTATION-0919",
      "@type": "Intent",
      "label": "Historical pause and Bread/Mini investigation before renewed implementation",
      "description": "Ember rejected Python as a new platform implementation language and required deeper Bread/Mini orientation and severe reevaluation of House. That investigation preceded the settled Mini rebuilding direction and newly authorized cycle 1; its investigation-only restriction is superseded for the new Mini work, while Python rejection remains in force.",
      "sources": [
        "urn:dregg:assortia:S-CORE-INTENT-0919",
        "urn:dregg:assortia:S-CYCLE-1-0919"
      ]
    },
    {
      "@id": "urn:dregg:assortia:C-BREAD-POLICY-REPLACEMENT-0919",
      "@type": "Claim",
      "label": "Bread replacement is checked under the new stored policy",
      "description": "apply_set_program writes the replacement before touched-cell program validation, which reads that new program and skips None. The inspected path does not require approval by the old policy, contrary to the accepted deliberate-management-lockout behavior.",
      "subject": "urn:dregg:assortia:R-breadstuffs",
      "sources": [
