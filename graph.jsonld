      "description": "Trace eligible jobs, registration/stake, result commitments, challenges, adjudication and penalty effects, including the difference between wrong results and availability failures.",
      "status": "backlog",
      "motivatedBy": [
        "urn:dregg:assortia:I-PROVIDERS"
      ],
      "closure": "Current source/evidence inventory; explicit job class, custody and verdict-to-effect boundaries. No transfers, stake locking or deployment.",
      "owner": null,
      "updatedAt": "2026-09-18T00:45:00-04:00",
      "advances": [
        "urn:dregg:assortia:E-PROVIDERS"
      ],
      "nextAction": "Choose the eligible public job and its exact result checker, provider obligation and penalty-record consumer.",
      "milestone": "urn:dregg:assortia:M-2026-09-26",
      "priority": 1,
      "progress": "Source inventory exists; connected provider eligibility/job/result/adjudication/penalty path is unfinished.",
      "blockedBy": [],
      "sources": [
        "urn:dregg:assortia:S-IMPLEMENTATION-0045"
      ]
    },
    {
      "@id": "urn:dregg:assortia:Q-STAKE",
      "@type": "Question",
      "label": "What does real stake mean during devnet?",
      "description": "Answered by ember: \"Lock real stake; record penalties only\". Real $DREGG is to be locked during devnet; adjudicated penalties are recorded without deducting them from the locked balance. Custody implementation and withdrawal/release conditions remain open; no asset action has been performed.",
      "status": "answered",
      "related": [
        "urn:dregg:assortia:I-PROVIDERS"
      ],
      "sources": [
        "urn:dregg:assortia:S-CONVERSATION"
      ]
    },
    {
      "@id": "urn:dregg:assortia:Q-SHARE",
      "@type": "Question",
      "label": "Which sharing modes should each resource support?",
      "description": "Live attenuated view, independently durable replica, pinned citation/content, or explicit modes; local rights and later settlement/revocation need precise contracts.",
      "status": "open-design-question",
      "related": [
        "urn:dregg:assortia:W-COORD-CONTRACT"
      ]
    },
    {
      "@id": "urn:dregg:assortia:C-CARD-IDENTITY",
      "@type": "Claim",
      "label": "Visible card editing and live card actions currently use different applets",
      "description": "ModeCardSurface mounts an AttachedApplet over the cockpit World for buttons/binds and a separately minted portable applet for CardEditor. edit_view repaints the pane without persisting the amended manifest into the focused World cell.",
      "subject": "urn:dregg:assortia:E-WORLD",
      "sources": [
        "urn:dregg:assortia:S-CARD-MOUNT",
        "urn:dregg:assortia:S-CARD-EDIT"
      ],
      "evidenceKind": "source-inspection",
      "scope": "Current ModeCardSurface native authoring route",
      "limitations": "Other applet APIs may support explicit export/remint; no test or UI run was performed here.",
      "status": "observed-in-source"
    },
    {
      "@id": "urn:dregg:assortia:C-MCP-WORLD",
      "@type": "Claim",
      "label": "Default MCP startup does not attach run_js to the cockpit World bridge",
      "description": "The MCP binary conditionally configures with_run_js under js-agent, but not with_world_bridge. Thus bridge library capability and ordinary server startup are separate.",
      "subject": "urn:dregg:assortia:E-HERMES",
      "sources": [
        "urn:dregg:assortia:S-MCP-START"
      ],
      "evidenceKind": "source-inspection",
      "scope": "deos-hermes mcp-server startup",
      "limitations": "Does not claim the socket bridge is absent; it is available for explicit composition.",
      "status": "observed-in-source"
    },
    {
      "@id": "urn:dregg:assortia:C-COMPUTE-SCOPE",
      "@type": "Claim",
      "label": "Compute constructs actual transfers but lacks payment-to-record and result binding",
      "description": "The offering calls fire_settle, which consumes settlement_effects including payment_effects/pay_effects and a conserving Transfer. The job policy does not bind the payee to PROVIDER_HASH or amount to PAID, POST budget is not funded escrow, and result admission checks nonempty text rather than a checked result against SPEC_HASH.",
      "subject": "urn:dregg:assortia:E-PROVIDERS",
      "sources": [
        "urn:dregg:assortia:S-COMPUTE",
        "urn:dregg:assortia:S-COMPUTE-PAYMENT",
        "urn:dregg:assortia:S-COMPUTE-POLICY-GAP"
      ],
      "evidenceKind": "source-and-contract-inspection",
      "scope": "dreggnet-compute do_settle through starbridge_compute_exchange::fire_settle",
      "limitations": "No settlement execution or real Solana custody observed. The helper creates a payment path; that does not prove its job/economic statement sufficient.",
      "status": "observed-in-source",
      "correction": "2026-09-17: replaced earlier field-only interpretation after tracing the real wrapper-to-helper consumer; the wrapper scope comment at line 781 is stale. Source bytes were unchanged, demonstrating that freshness alone does not validate an interpretation."
    },
    {
      "@id": "urn:dregg:assortia:C-SLASH-SCOPE",
      "@type": "Claim",
      "label": "Relay custody has a slash construction with distinct live-submission and evidence gaps",
      "description": "A signed cell-intake construction and transfer composition coexist with a legacy mirror-only HTTP route. The route also lacks a per-message refund witness. This is a custody-fault protocol, not a general incorrect-computation judge.",
      "subject": "urn:dregg:assortia:E-PROVIDERS",
      "sources": [
        "urn:dregg:assortia:S-RELAY-DISPUTE"
      ],
      "evidenceKind": "source-and-contract-inspection",
      "scope": "Inspected relay custody dispute path",
      "limitations": "No deployed bond seizure, public provider stake registry, or generalized compute challenge loop was observed.",
      "status": "integration-boundaries"
    },
    {
      "@id": "urn:dregg:assortia:C-PROVIDER-MARKET",
      "@type": "Claim",
      "label": "A complete public provider/stake/challenge/reputation path was not located in this inspection",
      "description": "Configured runtime providers, leases/meters, job-cell accounting, bounded service custody, and relay fault adjudication exist in separate paths. No devnet shadow-penalty leaderboard or funded public provider registry was located.",
      "subject": "urn:dregg:assortia:E-PROVIDERS",
      "sources": [
        "urn:dregg:assortia:S-PROVIDERS-REVIEW"
      ],
      "evidenceKind": "bounded-source-search",
      "scope": "Paths named in research/providers.md",
      "limitations": "Not a global absence proof, live infrastructure inventory, or declaration that no other experiment exists.",
      "status": "not-established-by-inspection"
    },
    {
      "@id": "urn:dregg:assortia:C-PROJECTION-V2",
      "@type": "Claim",
      "label": "An uncommitted Uwueave projection crossing already exists as neutral data",
      "description": "The dirty minidregg lane projects upstream Uwueave data into generated Rust; its live uses are an umbrella import, Rust include and static-data tests. The receiving contract explicitly withholds admission, verifier, dispatch or permit authority.",
      "subject": "urn:dregg:assortia:E-COORD",
