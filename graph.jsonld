      "@id": "urn:dregg:assortia:C-HYPERDOC-TOOL-SCOPE",
      "@type": "Claim",
      "label": "Hyperdocument content actions do not themselves define arbitrary tool execution",
      "description": "The inspected action grammar is create, editAtom, link, transclude, mark and annotate. SemanticEffectFamily separately supplies typed declaration/outcome, evidence and a unique patch. A public-document transform needs a selected computation family and receiving evaluator; a program label or content link alone does not provide those semantics.",
      "subject": "urn:dregg:assortia:E-WORLD",
      "sources": [
        "urn:dregg:assortia:S-HYPERDOC-ACTIONS",
        "urn:dregg:assortia:S-EFFECT-FAMILY"
      ],
      "evidenceKind": "source-inspection",
      "status": "observed-in-source",
      "scope": "Selected Hyperdocument action grammar and accepted-effect family definitions",
      "limitations": "Not a global absence claim about computation families elsewhere. No proof replay, runtime selection or transform implementation."
    },
