    {
      "@id": "urn:dregg:assortia:I-HOSTED-HERMES",
      "@type": "Intent",
      "label": "A complete hosted Nous Hermes experience with DREGG programmability",
      "description": "Ember wants hosted Nous Research Hermes on our resources with metering and kernel/shell programmability. SSH is suggested, not selected. External unforked Hermes support is desirable if practical. The user leans toward a custom remote-control interface; ACP, MCP, A2A and kernel/runtime choices remain open.",
      "sources": [
        "urn:dregg:assortia:S-DIRECTION-0919"
      ]
    },
    {
      "@id": "urn:dregg:assortia:I-HOSTED-CREDENTIAL-CUSTODY",
      "@type": "Intent",
      "label": "Initial hosted OpenRouter-key custody with scoped use",
      "description": "Ember accepts a credential service holding a user-provided OpenRouter key while Hermes receives permission to request its use. Desired TLSNotary and parsing evidence should bind authorized request construction to the exchange. This does not prevent unrecorded use by the custodian or establish that present certificates close the intended relation.",
      "sources": [
        "urn:dregg:assortia:S-DIRECTION-0919"
      ]
    },
    {
      "@id": "urn:dregg:assortia:I-SEMANTICS-BEFORE-FULL-PROOFS",
      "@type": "Intent",
      "label": "Operate intended semantics before full STARK assurance is complete",
      "description": "Ember wants to operate the system semantics while full STARK assurance remains incomplete. Actual kernel authorization, persistence, isolation and receiving operations remain required work. Neither Bread nor Mini is selected or declared ready by this intent.",
      "sources": [
        "urn:dregg:assortia:S-DIRECTION-0919"
      ]
    },
    {
      "@id": "urn:dregg:assortia:I-DESIGN-MODE-0919",
