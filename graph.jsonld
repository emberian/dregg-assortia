    {
      "@id": "urn:dregg:assortia:S-HOST-SESSION-PROPOSAL-0919",
      "@type": "Source",
      "label": "Proposed persistent verified host session, grounded in measured native replay cost",
      "repository": "urn:dregg:assortia:R-assortia",
      "path": "sprints/2026-09-19/next-cycle-host-session.md",
      "lineStart": 1,
      "lineEnd": 29,
