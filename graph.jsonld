      "evidenceKind": "source-inspection",
      "scope": "Specific starbridge-v2 desktop document path at the recorded bytes",
      "limitations": "No fresh test run. This is not a claim that every dregg-doc storage path has this limitation.",
      "status": "observed-in-source"
    },
    {
      "@id": "urn:dregg:assortia:C-DOC-SCENARIO",
