      "subject": "urn:dregg:assortia:E-WORLD"
    },
    {
      "@id": "urn:dregg:assortia:I-GIT",
      "@type": "Intent",
      "label": "Git remains primary; Fossil considered for non-VCS collaboration",
      "description": "Evaluate issues, discussion and project-memory capabilities without a suite-wide VCS migration.",
      "sources": [
        "urn:dregg:assortia:S-CONVERSATION"
      ]
    },
    {
      "@id": "urn:dregg:assortia:I-CURRENT",
      "@type": "Intent",
      "label": "Investigate current holdings; no past demo is the chosen target",
      "description": "Ember answered that none of the old demos felt close to the desired world. The initial task was present-state investigation. The next instruction asks us to use that inventory to establish coherent design intent and the next user experience; no old demo is selected by assumption.",
      "sources": [
        "urn:dregg:assortia:S-CONVERSATION"
      ]
    },
    {
      "@id": "urn:dregg:assortia:I-PROVIDERS",
      "@type": "Intent",
      "label": "Contributed heterogeneous hosting with real $DREGG stake and devnet shadow penalties",
      "description": "Allow contributors to run eligible publicly executable jobs; use optimistic adjudication and provider reputation. Ember chose actual locking of real $DREGG for devnet, with penalties recorded on reputation/the leaderboard and no monetary deduction for those penalties. The custody mechanism and withdrawal/release conditions remain open.",
      "subject": "urn:dregg:assortia:E-PROVIDERS",
      "sources": [
        "urn:dregg:assortia:S-CONVERSATION"
      ]
    },
    {
      "@id": "urn:dregg:assortia:C-DOC-DURABLE",
      "@type": "Claim",
      "label": "Current desktop heap persistence refuses after a durable cell has participated in a turn",
      "description": "edit_doc uses set_cell_heap before the revision SetField. The heap setter rejects a durable cell already touched by a committed turn; && suppresses the revision turn on rejection, while the sidecar has been saved.",
      "subject": "urn:dregg:assortia:E-DOC",
      "sources": [
        "urn:dregg:assortia:S-DOC-EDIT",
        "urn:dregg:assortia:S-DOC-HEAP",
