    {
      "@id": "urn:dregg:assortia:I-FOREGROUND-PAUSE",
      "@type": "Intent",
      "label": "Normal disconnect interrupts execution; soft disconnect continues within existing grants",
      "description": "Ember strengthened the normal disconnect behavior to an immediate circuit breaker for ongoing tools and processing, with task continuation after reconnection. Explicit soft mode means keep working within the existing authority and budget. This supersedes simply waiting for in-flight work to finish. Exact detection, enforcement, scope and recovery mechanisms remain design work.",
      "sources": [
        "urn:dregg:assortia:S-DIRECTION-0919",
        "urn:dregg:assortia:S-CONNECTION-BREAKER-0919"
      ],
      "subject": "urn:dregg:assortia:E-GRAINS"
    },
    {
      "@id": "urn:dregg:assortia:C-GRAIN-RECOVERY-0919",
      "@type": "Claim",
      "label": "Current served grain recovery depends on retained in-memory tenant state",
      "description": "AgentPlatform starts with an empty in-memory tenant map. Its lease carrier and local node are held in memory, and wake_from_lease first looks up the tenant. Source also places committed action admission before budget draw and external effect, followed by later receipt/checkpoint steps.",
      "subject": "urn:dregg:assortia:E-GRAINS",
      "sources": [
        "urn:dregg:assortia:S-GRAIN-CONTROL-0919",
        "urn:dregg:assortia:S-PROTOCOL-REVIEW-0919"
      ],
      "evidenceKind": "source-inspection",
      "scope": "Inspected Bread agent-platform, dregg-agent, grain-turn and hosted-lease paths; source hashes in the September 19 inventory.",
      "limitations": "No new execution. Reconstruction primitives exist; this does not assert absence of storage throughout the wider suite. Crash-window consequences are source inferences.",
      "status": "observed-in-source"
    },
    {
      "@id": "urn:dregg:assortia:C-HERMES-ADAPTERS-0919",
      "@type": "Claim",
      "label": "Upstream Hermes has reusable persistence and ACP/MCP/provider configuration",
      "description": "The inspected upstream checkout supports a persistent Hermes home/session database, ACP load/resume, MCP tools and alternate provider endpoints. This supports an unmodified hosted-Hermes candidate under a separate DREGG supervisor.",
      "subject": "urn:dregg:assortia:E-HERMES",
      "sources": [
        "urn:dregg:assortia:S-HERMES-EDGES-0919",
        "urn:dregg:assortia:S-PROTOCOL-REVIEW-0919"
      ],
      "evidenceKind": "source-inspection",
      "scope": "Inspected Hermes 0.17.0 checkout and Bread deos-hermes adapter.",
      "limitations": "No runtime acceptance. ACP is not a universal tool-authorization hook, MCP is additive, provider fallbacks need separate routing control, and session reload is not durable continuation of an arbitrary interrupted tool.",
      "status": "observed-in-source"
    },
    {
      "@id": "urn:dregg:assortia:C-PROVIDER-REQUEST-GAP-0919",
      "@type": "Claim",
      "label": "Current portable zkOracle acceptance does not bind authorized provider request construction",
      "description": "The inspected TLS verifiers retain authenticated sent views, but higher AuthenticSession adapters drop them; current POST disclosures omit request bodies. Response CFG proves syntax. Binding delegated request policy to authenticated bytes and joining actual upstream Hermes consumption remain integration/design obligations.",
      "subject": "urn:dregg:assortia:E-HERMES",
      "sources": [
        "urn:dregg:assortia:S-PROVIDER-EVIDENCE-0919",
        "urn:dregg:assortia:S-PROTOCOL-REVIEW-0919"
      ],
      "evidenceKind": "source-inspection",
      "scope": "Inspected Bread zkoracle-live/prove, provider callers and attestation helpers; dated August test evidence remains separate.",
      "limitations": "No new provider call or proof run. Broker policy enforcement is narrower than full upstream Hermes construction/consumption proof; host custody logs do not prove complete use against a dishonest custodian.",
      "status": "observed-in-source"
    },
    {
