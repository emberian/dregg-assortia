    {
      "@id": "urn:dregg:assortia:C-HERMES-CANCELLATION-0919",
      "@type": "Claim",
      "label": "Upstream ACP cancellation is cooperative and does not establish scope-wide stoppage",
      "description": "ACP cancel signals the active agent without waiting for quiescence. Detached async delegation has a separate interrupt registry; sequential/parallel tool results may arrive after cancel; the ACP handler can drain queued prompts after cancellation. Conversation persistence is not a durable interrupted-task frontier. Host/controller enforcement remains necessary for the intended disconnect contract.",
      "subject": "urn:dregg:assortia:E-HERMES",
      "sources": [
        "urn:dregg:assortia:S-HERMES-BREAKER-0919",
        "urn:dregg:assortia:S-CONNECTION-BREAKER-0919"
      ],
      "evidenceKind": "source-inspection",
      "scope": "Inspected upstream Hermes cancellation, tool and delegation paths; exact selected source hashes in circuit-breaker-inventory.json.",
      "limitations": "No runtime interruption or latency measurement; ACP SDK EOF behavior not inspected. Late-result and executor-wait consequences include explicitly labeled source inferences.",
      "status": "observed-in-source"
    },
