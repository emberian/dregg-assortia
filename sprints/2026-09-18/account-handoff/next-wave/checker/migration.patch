+    id := ⟨101⟩
+    parent := some parent.id
+    holder := .subject bob
+    scope := ⟨{⟨200⟩}, {.observeObject, .mutateObject}, 20⟩
+    notBefore := 1
+    notAfter := 80
+    ancestors := {parent.id} }
+
+def request : Request .object where
