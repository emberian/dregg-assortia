+    fn unicode_escape_unit(&mut self) -> Result<u16, String> {
+        if self.i + 4 > self.s.len() {
+            return Err("incomplete unicode escape".into());
+        }
+        let mut unit = 0u16;
+        for _ in 0..4 {
